---
// Tu archivo de página principal
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>Portafolio Animado con Astro</title>
		<style>
			body {
				margin: 0;
				background: #0f172a;
				display: flex;
				justify-content: center;
				align-items: center;
				min-height: 100vh;
			}
			svg {
				width: 200px;
				height: 200px;
			}
		</style>
	</head>
	<body>

		<!-- Tu diseño vectorial insertado directamente en el HTML -->
		<svg viewBox="0 0 100 100">
			<circle class="mi-circulo" cx="50" cy="50" r="40" fill="#38bdf8" />
		</svg>

		<!-- Bloque de Script donde vive GSAP -->
		<script>
			import { gsap } from 'gsap';

			// Animación básica de escala y rebote infinito
			gsap.to('.mi-circulo', {
				scale: 0.5,
				transformOrigin: 'center',
				duration: 1,
				yoyo: true,
				repeat: -1,
				ease: 'power1.inOut'
			});
		</script>

	</body>
</html>